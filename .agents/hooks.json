{
  "session-rehydration": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python scripts/workflow_hooks.py session-start",
        "timeout": 10
      }
    ]
  },
  "backup-and-command-guard": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/workflow_hooks.py pre-tool",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/workflow_hooks.py pre-tool",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "workflow-hygiene-postcheck": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/workflow_hooks.py post-tool",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "alert-stop-gate": {
    "enabled": false,
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/workflow_hooks.py stop",
        "timeout": 10
      }
    ]
  }
}
